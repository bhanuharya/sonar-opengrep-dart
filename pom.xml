<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>io.github.bhanuharya</groupId>
  <artifactId>sonar-opengrep-dart-plugin</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>sonar-plugin</packaging>

  <name>OpenGrep for Dart (SonarQube)</name>
  <description>Dart and Flutter security rules for SonarQube: OpenGrep findings imported as native Vulnerabilities and Security Hotspots with CWE/OWASP mapping.</description>
  <url>https://github.com/bhanuharya/sonar-opengrep-dart</url>
  <inceptionYear>2026</inceptionYear>

  <licenses>
    <license>
      <name>GNU LGPL 3</name>
      <url>http://www.gnu.org/licenses/lgpl.txt</url>
    </license>
  </licenses>

  <properties>
    <maven.compiler.release>17</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!-- The oldest API we support: the one SonarQube 9.9 LTA ships. -->
    <sonar.plugin.api.version>9.14.0.375</sonar.plugin.api.version>
    <sonar.plugin.api.impl.version>9.9.0.65466</sonar.plugin.api.impl.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.sonarsource.api.plugin</groupId>
      <artifactId>sonar-plugin-api</artifactId>
      <version>${sonar.plugin.api.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.yaml</groupId>
      <artifactId>snakeyaml</artifactId>
      <version>2.3</version>
    </dependency>
    <dependency>
      <groupId>com.google.code.gson</groupId>
      <artifactId>gson</artifactId>
      <version>2.11.0</version>
    </dependency>

    <dependency>
      <groupId>org.sonarsource.sonarqube</groupId>
      <artifactId>sonar-plugin-api-impl</artifactId>
      <version>${sonar.plugin.api.impl.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>5.11.3</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <version>3.26.3</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.mockito</groupId>
      <artifactId>mockito-core</artifactId>
      <version>5.14.2</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <resources>
      <resource>
        <directory>src/main/resources</directory>
      </resource>
      <!-- The bundled rule pack ships inside the jar; test fixtures stay out. -->
      <resource>
        <directory>rules</directory>
        <targetPath>opengrep-rules</targetPath>
        <includes>
          <include>**/*.yaml</include>
          <include>**/*.yml</include>
        </includes>
      </resource>
    </resources>
    <plugins>
      <plugin>
        <groupId>org.sonarsource.sonar-packaging-maven-plugin</groupId>
        <artifactId>sonar-packaging-maven-plugin</artifactId>
        <version>1.23.0.740</version>
        <extensions>true</extensions>
        <configuration>
          <pluginKey>opengrep</pluginKey>
          <pluginClass>io.github.bhanuharya.sonar.opengrep.OpenGrepPlugin</pluginClass>
          <pluginName>OpenGrep Dart</pluginName>
          <!-- Plugin API 9.14 is what SonarQube 9.9 LTA ships. -->
          <pluginApiMinVersion>9.14</pluginApiMinVersion>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.2</version>
      </plugin>
    </plugins>
  </build>
</project>
